{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ad/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' http://tauri.localhost https://tauri.localhost tauri://localhost http://localhost:1420"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/ads.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/api/license/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "auth.getvelmora.dpdns.org"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com https://cdn.discordapp.com; connect-src 'self' https://htvirqckkhfekgfwxops.supabase.co https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com https://cdn.discordapp.com https://image.tmdb.org https://i.ytimg.com; connect-src 'self' https://htvirqckkhfekgfwxops.supabase.co wss://htvirqckkhfekgfwxops.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "auth.getvelmora.dpdns.org"
        }
      ],
      "destination": "/auth/",
      "permanent": false
    },
    {
      "source": "/auth",
      "has": [
        {
          "type": "host",
          "value": "getvelmora.dpdns.org"
        }
      ],
      "destination": "https://auth.getvelmora.dpdns.org/auth/",
      "permanent": false
    },
    {
      "source": "/auth/:path*",
      "has": [
        {
          "type": "host",
          "value": "getvelmora.dpdns.org"
        }
      ],
      "destination": "https://auth.getvelmora.dpdns.org/auth/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/",
      "permanent": false
    },
    {
      "source": "/social/:path*",
      "has": [
        {
          "type": "host",
          "value": "getvelmora.dpdns.org"
        }
      ],
      "destination": "https://social.getvelmora.dpdns.org/social/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/@:user",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/api/social/page?u=:user"
    },
    {
      "source": "/@:user/:tab",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/api/social/page?u=:user"
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/"
    },
    {
      "source": "/settings",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/"
    },
    {
      "source": "/trending",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/"
    },
    {
      "source": "/trending/:tab",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/"
    },
    {
      "source": "/leaderboards",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/"
    },
    {
      "source": "/title/:kind/:id",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/"
    },
    {
      "source": "/list/:id",
      "has": [
        {
          "type": "host",
          "value": "social.getvelmora.dpdns.org"
        }
      ],
      "destination": "/social/"
    }
  ]
}
