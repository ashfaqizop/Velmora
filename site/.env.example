# Adsterra ad codes. Set these in Vercel (Project → Settings → Environment
# Variables), not in a committed file. Any you leave out just shows no ad.

# Banner keys: the `key` value from each Banner ad code, one per size.
VITE_ADSTERRA_BANNER_728=
VITE_ADSTERRA_BANNER_300=
VITE_ADSTERRA_BANNER_320=
# The host in your banner code's invoke.js URL, if it isn't this one.
VITE_ADSTERRA_HOST=www.highperformanceformat.com

# Native Banner: the full invoke.js URL from its ad code.
VITE_ADSTERRA_NATIVE=
