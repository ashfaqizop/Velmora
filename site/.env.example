# Adsterra codes are public and live in src/lib/ads.ts (site) and public/ad/ (app).

# Sports cache proxy (api/sports). Set these in Vercel too; they are read at
# request time, never shipped to the browser or the app.
SPORTSDB_KEY=
FOOTBALL_DATA_TOKEN=

# Max licenses (api/license). See tools/license/README.md.
# The Upstash for Redis integration adds these two on its own:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# From `node tools/license/velmora-license.mjs init`:
LICENSE_SERVER_KEY=
LICENSE_ADMIN_TOKEN=
# Lets the admin site make Max keys. From `node tools/license/velmora-license.mjs secret signing`:
LICENSE_SIGNING_KEY=

# Admin site remote config: fine-grained GitHub token, this repo only, Contents read/write.
# The code only ever writes registry.json on the config branch.
CONFIG_GITHUB_TOKEN=
