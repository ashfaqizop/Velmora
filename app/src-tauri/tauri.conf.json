{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velmora",
  "version": "../package.json",
  "identifier": "app.velmora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velmora",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Entertainment",
    "shortDescription": "Movies, series and anime in one place",
    "copyright": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQkRCNDZGMzY3RUY4RDIKUldUUytINDJiN1M5c1hyRXV2R0x5T2pyWEpKbHJDVEJLaTd4Z3pVNDBOcXNQenpsWklzdnJ3QzcK",
      "endpoints": ["https://github.com/ashfaqizop/Velmora/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
